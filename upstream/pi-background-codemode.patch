+/** The inputs that report background calls, in order. */
+async function reports(root: Awaited<ReturnType<typeof openChat>>["root"]): Promise<string[]> {
+	return (await allEntries(root)).flatMap((entry) => {
+		const text = textOf(entry.model?.[0]);
+		return entry.model?.[0]?.role === "user" && text?.startsWith("[Background ") === true ? [text] : [];
+	});
+}
+
+/** Polls `check` until it holds, for work that runs outside the test's microtasks, such as a script's VM. */
+async function waitFor(check: () => Promise<boolean>): Promise<void> {
+	for (let attempt = 0; attempt < 500; attempt++) {
+		if (await check()) return;
+		await new Promise((resolve) => setTimeout(resolve, 10));
+	}
+	throw new Error("Condition was not reached");
+}
