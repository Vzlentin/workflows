{
	"name": "@vzlentin/pi-workflows",
	"version": "0.7.0",
	"description": "The workflow tool of workflows in Pi",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/workflows.git"
	},
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts",
			"../pi-agents/index.ts",
			"./node_modules/@vzlentin/pi-agents/index.ts"
		],
		"skills": [
			"./skills",
			"../pi-agents/skills",
			"./node_modules/@vzlentin/pi-agents/skills"
		]
	},
	"dependencies": {
		"@vzlentin/pi-agents": "^0.6.0",
		"@vzlentin/workflows": "0.7.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
