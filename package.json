{
	"name": "@vzlentin/workflows",
	"version": "0.6.1",
	"description": "Ship one work item onto a new branch through durable Pi sessions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/workflows.git"
	},
	"type": "module",
	"bin": {
		"workflows": "dist/cli.js"
	},
	"files": [
		"dist",
		"workflows"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"check": "biome check . && oxlint --deny-warnings && tsc -p tsconfig.json && tsc -p workflows/jsconfig.json && vitest --run",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@vzlentin/harness": "^0.6.2",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@oxlint/plugins": "1.88.0",
		"@types/node": "26.6.4",
		"oxlint": "1.88.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
