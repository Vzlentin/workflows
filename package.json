{
	"name": "@vzlentin/workflows",
	"version": "0.6.1",
	"description": "Ship one work item onto a new branch through durable Pi sessions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/workflows.git"
	},
	"bin": {
		"workflows": "dist/cli.js"
	},
	"files": [
		"dist",
		"workflows"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"prepare": "npm run build",
		"prepack": "npm run build",
		"check": "vp check --deny-warnings && npm run build && tsc -p tsconfig.json && tsc -p workflows/jsconfig.json && vp test",
		"test": "vp test"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-codemode": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@vzlentin/harness": "git+https://github.com/Vzlentin/harness.git#0d79ae2ea1a70708eba944d9ab20443ec2831a57",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
